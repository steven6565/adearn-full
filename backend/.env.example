# Copy to .env on Render (never commit .env, never put these in frontend code)
# Telegram bot token from BotFather — backend only
BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
# Supabase Postgres connection string (Settings -> Database -> Connection string, pooler or direct)
# Example: postgresql://postgres.<project-ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@YOUR_HOST:5432/postgres
# Secret Monetag (or Adsgram) must send with its postback. Invent a long random string.
POSTBACK_SECRET=change-me-to-a-long-random-string
# Which provider is live right now: "monetag" or "none". Keep "none" until Monetag is configured.
AD_PROVIDER=none
# Monetag zone id, only used when AD_PROVIDER=monetag. Public zone ids are not secrets,
# but keep them in env anyway so swapping providers needs no code change.
MONETAG_ZONE_ID=
# Daily rewarded-credit cap per user (abuse limit, tunable)
DAILY_CREDIT_CAP=20
# Frontend origin allowed to call this API, e.g. https://adearn.pages.dev
FRONTEND_ORIGIN=https://your-frontend.pages.dev
PORT=3000
